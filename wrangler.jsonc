/**
 * hyper-tetris — Cloudflare Workers (static assets only)
 * https://developers.cloudflare.com/workers/static-assets/
 *
 * The build output is plain static files, so there is no Worker script (main).
 * Security headers take effect because public/_headers is copied into dist.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyper-tetris",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    // Vercel also served plain static files without rewrites, so unknown paths stay 404.
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
